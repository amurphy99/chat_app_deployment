# >>> NOTE: Strip spaces around equal signs for the real .env file <<<

# ================================================================================
# GitHub Info (only the branch names should change)
# ================================================================================
# Deployment repository info
GITHUB_USER       = amurphy99
GITHUB_REPO       = chat_app_deployment
SETUP_REPO_BRANCH = main

# Speech System repository info
REPO_NAME   = v2_benchmarking
REPO_BRANCH = main

# --------------------------------------------------------------------------------
# Deployment Script Configuration
# --------------------------------------------------------------------------------
# Set to "true" to skip re-downloading model files if they are already staged locally.
# Default (unset or "false") = always re-download from the GCS bucket.
SKIP_MODEL_REDOWNLOAD=false

# Same behavior as with the model files above but for the seed/demo data
SKIP_SEED_DATA_REDOWNLOAD=false

# Email used for Let's Encrypt certificate registration and renewal notices
CERT_EMAIL = 

# --------------------------------------------------------------------------------
# Distinguishes between "main" and "sandbox" deployment
# --------------------------------------------------------------------------------
# Use "main" ONLY if this deployment is intended to be the stable, "production"
# instance. The "main" instance gets mapped to "cognibot.org" and `TARGET_PREFIX`
# below will be ignored.
#  * Sandbox uses: "TARGET_PREFIX.cognibot.org" and "TARGET_PREFIX/recordings/"
#  * Main uses: "cognibot.org" and "main/recordings/"

# Select the public hostname and audio namespace: "sandbox" or "main"
DEPLOYMENT_TARGET=sandbox

# URL modifier to map to (e.g. "sandbox.cognibot.org", "sandbox2.cognibot.org", etc.)
# We have used: sandbox1 | sandbox2 | sandbox3
TARGET_PREFIX=sandbox1


# ================================================================================
# Backend
# ================================================================================
# Django config
DJANGO_SETTINGS_MODULE  = "backend.settings"
DJANGO_DEBUG            = false
DJANGO_SECRET_KEY       =
TZ                      = "UTC"

# --------------------------------------------------------------------------------
# Google Cloud Credentials
# --------------------------------------------------------------------------------
# Used for speech (STT & TTS) as well as cloud storage (GCS) bucket access
GOOGLE_APPLICATION_CREDENTIALS = /app/google-stt-key.json
GOOGLE_API_KEY                 =
GOOGLE_GENAI_USE_VERTEXAI      = 0

# ================================================================================
# Database
# ================================================================================
# The host and port options are for when we are in **external** DB mode. If the
# target deployment uses a local (same machine) database, then we don't need them.

# Postgres Chat DB
__POSTGRES_DB       =
__POSTGRES_USER     =
__POSTGRES_PASSWORD =
__POSTGRES_HOST     = db
__POSTGRES_PORT     = 5432

# Postgres Vector DB
__VECTOR_DB_NAME     =
__VECTOR_DB_USER     =
__VECTOR_DB_PASSWORD =
__VECTOR_DB_HOST     = db_vector
__VECTOR_DB_PORT     = 5432

# --------------------------------------------------------------------------------
# Audio Storage
# --------------------------------------------------------------------------------
# Session audio storage (use "local" for local Docker, "gcs" on the deployed VM)
SESSION_AUDIO_STORAGE    = gcs         # local | gcs
SESSION_AUDIO_LOCAL_ROOT = /app/media  # Where .wav files are saved when in "local" mode

# Where recordings are stored locally before a chat ends and they get deleted or uploaded
SESSION_AUDIO_TEMP_ROOT  = /tmp/cognibot_recordings

# Configuration for Google Cloud Storage mode
# The deployment code prepends the instance name (e.g., "sandbox1/recordings")
SESSION_AUDIO_GCS_BUCKET           = session_audio-v1
SESSION_AUDIO_OBJECT_PREFIX        = recordings
SESSION_AUDIO_PLAYBACK_URL_TTL_SEC = 3600

# --------------------------------------------------------------------------------
# Admin & Demo user login information
# --------------------------------------------------------------------------------
# Primary admin user
ADMIN_USERNAME_0 = 
ADMIN_PASSWORD_0 = 

# Protected demo data user
DEMO_USERNAME_0 = 
DEMO_PASSWORD_0 = 

# ================================================================================
# LLM Settings
# ================================================================================
# API access
IU_URL=
IU_KEY=

# Standard (non-activity) chat response mode: "single_stage" | "active_listening"
LIVE_CHAT_RESPONSE_MODE = "single_stage"

# Specify which model to use: "gemma-4-31B-it" | "Qwen3-Coder-Next"
LLM_NAME = "gemma-4-31B-it"

# --------------------------------------------------------------------------------
# Llama API [deprecated] (comes from old self-hosted fine-tuned model we used)
# --------------------------------------------------------------------------------
# GPU instance internal IP & token used by CPU instances to access the LLM API
LLM_BASE_URL=
LLM_GATEWAY_TOKEN=

# ================================================================================
# Misc.
# ================================================================================
# Image API
__PEXELS_KEY =

# Azure Speech [deprecated]
__SPEECH_KEY=
